---
import { LinkButton } from "@astrojs/starlight/components";
import HeroStage from "./HeroStage.svelte";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero-wrap">
  <div class="hero-head">
    <p class="eyebrow">
      <span class="eyebrow__dot"></span> Interactive Git course
    </p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(
            ({
              attrs: { class: className, ...attrs } = {},
              icon,
              link: href,
              text,
              variant,
            }) => (
              <LinkButton
                {href}
                {variant}
                icon={icon?.name}
                class:list={[className]}
                {...attrs}
              >
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
  </div>

  <div class="hero-stage-wrap">
    <HeroStage client:only="svelte" />
  </div>
</div>

<style>
  .hero-wrap {
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }
  .hero-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--git-orange);
    margin: 0 0 0.5rem;
  }
  .eyebrow__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--git-orange);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--git-orange) 70%, transparent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--git-orange) 60%, transparent);
    }
    70% {
      box-shadow: 0 0 0 0.6rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .hero-head h1 {
    font-size: clamp(2.5rem, 1rem + 6vw, 4.75rem);
    line-height: 1.04;
    font-weight: 700;
    margin: 0 0 1rem;
    background: linear-gradient(
      120deg,
      var(--sl-color-white) 0%,
      var(--git-orange) 55%,
      var(--git-orange-soft) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tagline {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.3rem);
    color: var(--sl-color-gray-2);
    max-width: 52ch;
    margin: 0 0 1.75rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem 1rem;
    margin-bottom: 1.75rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }
  .hero-meta strong {
    color: var(--sl-color-white);
    font-size: 1.15rem;
    margin-right: 0.2rem;
  }
  .hero-meta span {
    color: var(--git-orange);
  }

  /* Break the stage out wider than the prose column for an immersive feel. */
  .hero-stage-wrap {
    position: relative;
    width: min(100vw - 2rem, 64rem);
    margin-inline: calc(50% - min(50vw - 1rem, 32rem));
  }
</style>
